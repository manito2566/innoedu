rules_version = '2';

// All reads/writes go through Next.js server code using the Firebase Admin SDK,
// which bypasses these rules. No client ever talks to Firestore directly, so
// direct client access is denied entirely.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
