rules_version = '2';

// Media assets (images/files for public innovation pages) are uploaded only
// via the admin API route using the Admin SDK, which bypasses these rules.
// Public read is allowed since this content is meant for dissemination;
// direct client writes are denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
